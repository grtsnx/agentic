NODE_ENV=development
PORT=3001
PLATFORM_NAME=Agentic

# Exact comma-separated origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=http://localhost:3001

# Swagger defaults to enabled outside production and disabled in production.
SWAGGER_ENABLED=true
REALTIME_PLAYGROUND_ENABLED=true

# Observability is opt-in. Supply all credentials when enabling it.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=

OPENAI_API_KEY=
MODEL_TIMEOUT_MS=60000
WEB_SEARCH_ENABLED=true
# Optional comma-separated hostnames without schemes or paths.
WEB_SEARCH_ALLOWED_DOMAINS=

# Optional external tools. Each requires its own server-side API key when enabled.
CONTEXT_DEV_ENABLED=false
CONTEXT_DEV_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
VALYU_ENABLED=false
VALYU_API_KEY=
EXTERNAL_TOOLS_TIMEOUT_MS=15000
EXTERNAL_TOOLS_MAX_CALLS=5
EXTERNAL_TOOLS_MAX_RESULTS=5
EXTERNAL_TOOLS_MAX_CHARS=12000

# In-memory only; sessions are lost when the process restarts.
SESSION_TTL_MS=1800000
SESSION_MAX_TURNS=50
SESSION_MAX_TOKENS=32000

# LiveKit Cloud voice is opt-in. Keep credentials server-side.
VOICE_ENABLED=false
VOICE_PROVIDER=livekit
VOICE_MODEL=gpt-realtime-2.1-mini
VOICE_NAME=marin
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=agentic-voice
# Optional: a provisioned number with an inbound dispatch rule for this agent.
LIVEKIT_PHONE_NUMBER=

# Opt-in local Docker execution. Requires the pinned sandbox image.
SANDBOX_ENABLED=false

# Optional Cloudflare Clef classifier. OpenAI still generates answers.
CLEF_ROUTING_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLEF_ROUTING_TIMEOUT_MS=3000
CLEF_ROUTING_CONFIDENCE=0.75

# Public ChatKit domain key. Localhost uses a development placeholder when empty.
CHATKIT_DOMAIN_KEY=

# Main-agent output cap per model call, including reasoning tokens.
MODEL_MAX_OUTPUT_TOKENS=8192

# Opt-in computer control from the local browser only. Disabled in production.
COMPUTER_ENABLED=false
COMPUTER_ALLOWED_APPS=*
COMPUTER_BROWSER_DOMAINS=example.com,example.org,developers.openai.com,docs.nestjs.com
# Optional absolute adapter executable; defaults to .computer-venv/bin/macos-harness
COMPUTER_MACOS_BINARY=

# Optional trusted MCP servers and local SKILL.md folders, shared across chat and voice.
AGENT_EXTENSIONS_ENABLED=false
AGENT_EXTENSIONS_FILE=agent-extensions.json

# Allow approved skill installation from localhost playground/local CLI (development only).
AGENT_SKILL_INSTALL_ENABLED=false
