{
  "name": "agentic",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "chat": "nest start --entryFile cli --env-file .env",
    "chat:prod": "node --env-file=.env dist/cli.js",
    "voice:dev": "bun run build && node --env-file=.env dist/voice.js dev",
    "voice:start": "node --env-file=.env dist/voice.js start",
    "voice:console": "bun run build && node --env-file=.env dist/config/livekit/livekit-console.js",
    "voice:devices": "lk agent console --list-devices",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json,md,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json,md,yaml}\" \".github/**/*.{yml,yaml}\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:debug": "NODE_ENV=test vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.config.e2e.ts",
    "smoke:provider": "NODE_ENV=test RUN_PROVIDER_SMOKE=true node --env-file=.env node_modules/vitest/vitest.mjs run --config ./vitest.config.smoke.ts",
    "smoke:tools": "NODE_ENV=test RUN_EXTERNAL_TOOLS_SMOKE=true node --env-file=.env node_modules/vitest/vitest.mjs run --config ./vitest.config.smoke.ts",
    "smoke:tool-selection": "NODE_ENV=test RUN_TOOL_SELECTION_SMOKE=true node --env-file=.env node_modules/vitest/vitest.mjs run --config ./vitest.config.smoke.ts",
    "smoke:search": "NODE_ENV=test RUN_SEARCH_SMOKE=true node --env-file=.env node_modules/vitest/vitest.mjs run --config ./vitest.config.smoke.ts test/smoke/search.smoke-spec.ts",
    "benchmark:routing": "NODE_ENV=test RUN_CLEF_BENCHMARK=true node --env-file=.env node_modules/vitest/vitest.mjs run --config ./vitest.config.smoke.ts test/smoke/clef-routing.smoke-spec.ts"
  },
  "dependencies": {
    "@livekit/agents": "1.9.4",
    "@livekit/agents-plugin-openai": "1.9.4",
    "@livekit/protocol": "1.53.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.17",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@openai/agents": "^0.21.0",
    "@scalar/nestjs-api-reference": "^1.2.31",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "context.dev": "3.15.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "firecrawl": "4.51.0",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "pdfjs-dist": "6.4.299",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.4",
    "thinking-orbs": "0.3.2",
    "valyu-js": "2.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
